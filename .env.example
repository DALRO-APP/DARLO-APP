# mock 모드는 서버/지도 키 없이 실행됩니다.
# hybrid는 EXPO_PUBLIC_SERVER_PURPOSES 목적만 서버(server/)로 추천받고 나머지는 더미로 시연합니다.
# http는 모든 목적을 서버로 보냅니다(현재 서버는 PACE만 지원, 나머지는 오류 표시).
EXPO_PUBLIC_DATA_SOURCE=mock
# 서버 URL. 앱 번들에 들어가므로 비밀값을 넣지 마세요. 휴대폰은 맥의 LAN IP를 씁니다.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SERVER_PURPOSES=PACE

# 웹의 실제 카카오 지도: JavaScript 키를 .env.local에 지정합니다.
# 비워두면 오프라인 시연 지도를 사용합니다. 배포/로컬 도메인을 카카오에 등록하세요.
EXPO_PUBLIC_KAKAO_MAP_JS_KEY=

# iOS/Android 개발 빌드용 Native 앱 식별 키. 서버 비밀키를 넣지 않습니다.
EXPO_PUBLIC_KAKAO_MAP_NATIVE_KEY=
