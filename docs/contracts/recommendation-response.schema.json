{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "request_id": {
      "type": "string"
    },
    "courses": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "subtitle": {
            "type": "string"
          },
          "purpose": {
            "type": "string",
            "enum": ["PACE", "POWER", "NIGHT", "GREEN"]
          },
          "region": {
            "type": "string"
          },
          "start_label": {
            "type": "string"
          },
          "geometry": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "LineString"
              },
              "coordinates": {
                "minItems": 4,
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "required": ["type", "coordinates"],
            "additionalProperties": false
          },
          "summary": {
            "type": "object",
            "properties": {
              "distance_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "estimated_duration_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "elevation_gain_m": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "avg_slope_pct": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "signal_count": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "crossing_count": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "light_count": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "green_ratio": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "environment_score": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "distance_m",
              "estimated_duration_s",
              "elevation_gain_m",
              "avg_slope_pct",
              "signal_count",
              "crossing_count",
              "light_count",
              "green_ratio",
              "environment_score"
            ],
            "additionalProperties": false
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "flat",
                    "hill",
                    "lighting",
                    "green",
                    "signals",
                    "loop"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": ["code", "title", "description"],
              "additionalProperties": false
            }
          },
          "segments": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "distance_from_start_m": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "name",
                "description",
                "distance_from_start_m"
              ],
              "additionalProperties": false
            }
          },
          "edge_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_version": {
            "type": "string"
          },
          "algorithm_version": {
            "type": "string"
          },
          "is_mock": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "subtitle",
          "purpose",
          "region",
          "start_label",
          "geometry",
          "summary",
          "reasons",
          "segments",
          "edge_ids",
          "data_version",
          "algorithm_version",
          "is_mock"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "request_id", "courses"],
  "additionalProperties": false
}
