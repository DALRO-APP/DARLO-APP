{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "FeatureCollection"
    },
    "features": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "Feature"
          },
          "geometry": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "LineString"
              },
              "coordinates": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "required": ["type", "coordinates"],
            "additionalProperties": false
          },
          "properties": {
            "type": "object",
            "properties": {
              "edge_id": {
                "type": "string",
                "minLength": 1
              },
              "from_node": {
                "type": "string",
                "minLength": 1
              },
              "to_node": {
                "type": "string",
                "minLength": 1
              },
              "length_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "walkable": {
                "type": "boolean"
              },
              "bidirectional": {
                "type": "boolean"
              },
              "slope_pct": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "elevation_gain_forward_m": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "elevation_gain_reverse_m": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "signal_cnt": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cross_cnt": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "light_cnt": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "park_dist_m": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "green_ratio": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "data_version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "edge_id",
              "from_node",
              "to_node",
              "length_m",
              "walkable",
              "bidirectional",
              "slope_pct",
              "elevation_gain_forward_m",
              "elevation_gain_reverse_m",
              "signal_cnt",
              "cross_cnt",
              "light_cnt",
              "park_dist_m",
              "green_ratio",
              "data_version"
            ],
            "additionalProperties": false
          }
        },
        "required": ["type", "geometry", "properties"],
        "additionalProperties": false
      }
    }
  },
  "required": ["type", "features"],
  "additionalProperties": false
}
