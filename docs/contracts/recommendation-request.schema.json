{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "start": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "purpose": {
          "type": "string",
          "enum": ["PACE", "POWER", "NIGHT", "GREEN"]
        },
        "time_of_day": {
          "type": "string",
          "enum": ["day", "night"]
        },
        "distance_tolerance_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3
        },
        "route_type": {
          "type": "string",
          "const": "loop"
        },
        "target_distance_m": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 20000
        }
      },
      "required": [
        "schema_version",
        "start",
        "purpose",
        "time_of_day",
        "distance_tolerance_ratio",
        "route_type",
        "target_distance_m"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "start": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "purpose": {
          "type": "string",
          "enum": ["PACE", "POWER", "NIGHT", "GREEN"]
        },
        "time_of_day": {
          "type": "string",
          "enum": ["day", "night"]
        },
        "distance_tolerance_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3
        },
        "route_type": {
          "type": "string",
          "const": "straight"
        },
        "end": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "target_distance_m": {
          "type": "null"
        }
      },
      "required": [
        "schema_version",
        "start",
        "purpose",
        "time_of_day",
        "distance_tolerance_ratio",
        "route_type",
        "end",
        "target_distance_m"
      ],
      "additionalProperties": false
    }
  ]
}
